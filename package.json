{
  "name": "ghostedwatch",
  "version": "0.0.1",
  "description": "Notifies you when your own content on patriots.win / scored.co / communities.win has been removed, and lets you self-test for shadow bans.",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "clean": "rimraf dist-chrome dist-firefox chrome.zip firefox.zip",
    "build-chrome": "NODE_ENV=production BROWSER=chrome webpack && (cd dist-chrome && zip -qr ../chrome.zip .)",
    "build-firefox": "NODE_ENV=production BROWSER=firefox webpack && (cd dist-firefox && zip -qr ../firefox.zip .)",
    "build-chrome-dev": "NODE_ENV=development BROWSER=chrome webpack",
    "build-firefox-dev": "NODE_ENV=development BROWSER=firefox webpack",
    "start-chrome": "NODE_ENV=development BROWSER=chrome webpack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:login": "node tests/e2e/login.mjs",
    "publish:chrome": "chrome-webstore-upload upload --source chrome.zip --auto-publish",
    "publish:firefox": "web-ext sign --channel=listed --source-dir dist-firefox --artifacts-dir web-ext-artifacts"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/chrome": "0.1.42",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "chrome-webstore-upload-cli": "4.0.0",
    "copy-webpack-plugin": "11.0.0",
    "rimraf": "6.1.3",
    "ts-loader": "9.5.7",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "web-ext": "10.1.0",
    "webpack": "5.106.2",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "react": "19.0.6",
    "react-dom": "19.0.6"
  }
}
