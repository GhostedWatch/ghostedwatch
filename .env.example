# Test-only configuration. Copy to .env (gitignored) and fill in as needed.
# Nothing here is required for the default offline test suites.

# --- authenticated, logged-in e2e (opt-in) ---
# Run: `yarn e2e:login` once (log in by hand), then `WIN_E2E_LIVE=1 yarn test:e2e`.
WIN_USER=
WIN_PASS=
WIN_ORIGIN=https://patriots.win
# A thread path containing one of YOUR removed comments, e.g.
# /p/<postUuid>/<slug>/c/ — used only by the logged-in highlight test. Kept out of
# the repo because it identifies your account.
WIN_E2E_THREAD=

# --- in-page canary (opt-in, network, no login) ---
# Run: `WIN_E2E_NET=1 yarn test:e2e`. Loads a live public thread (discovered at
# runtime from the hot feed) and checks the in-page highlight/Watch behavior.
# WIN_E2E_NET=1
# WIN_E2E_COMMUNITY=TheDonald

# --- store publishing (yarn publish:all / publish:chrome / publish:firefox) ---
# Same variable names as the reveddit real-time extension, so account-level
# values (everything except CHROME_EXTENSION_ID) can be copied from its .env.
# Chrome: OAuth client of the Google account that owns the listing; refresh
# token minted by `yarn refresh:chrome` (which also keeps this file updated).
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
# Optional: the numeric publisher id in dashboard URLs, used to build the edit link.
CHROME_DASHBOARD_ID=
# OAUTH_PORT=3000
# Firefox: JWT credentials from https://addons.mozilla.org/developers/addon/api/key/
# (per AMO account). The add-on id is read from the built manifest automatically;
# set FIREFOX_EXTENSION_ID only to override it.
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
# FIREFOX_EXTENSION_ID=
